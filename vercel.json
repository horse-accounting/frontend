{
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        { "type": "host", "value": "frontend-weld-iota-75.vercel.app" }
      ],
      "status": 404,
      "dest": "/404.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
